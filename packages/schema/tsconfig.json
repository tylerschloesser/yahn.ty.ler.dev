{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": [],
    // Consumed as source by Vite, esbuild and vitest, never emitted, so
    // relative imports name the real file.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"]
}
