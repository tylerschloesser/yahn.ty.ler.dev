{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm e2e)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm exec *)",

      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",

      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh search:*)",
      "Bash(gh label list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh variable list:*)",

      "Bash(vercel env pull:*)",
      "Bash(vercel inspect:*)",
      "Bash(vercel ls:*)",

      "Bash(curl -sS http://localhost:5173/*)",
      "Bash(curl -sS http://localhost:3001/*)",
      "Bash(curl -sSI http://localhost:5173/*)",
      "Bash(curl -sSI http://localhost:3001/*)",
      "Bash(curl -sS https://yahn.vercel.app/*)",
      "Bash(curl -sSI https://yahn.vercel.app/*)",
      "Bash(curl -sS https://*.vercel.app/*)",
      "Bash(curl -sSI https://*.vercel.app/*)",

      "WebFetch(domain:base-ui.com)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:hn.algolia.com)",
      "WebFetch(domain:vercel.com)",
      "WebFetch(domain:github.com)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const j=JSON.parse(d);const p=(j.tool_input&&j.tool_input.file_path)||'';if(p.includes('/generated/')||p.startsWith('generated/')||p.endsWith('src/routeTree.gen.ts')){console.error('Blocked: '+p+' is generated; do not Edit/Write it directly.');process.exit(2)}process.exit(0)}catch(e){process.exit(0)}})\""
          }
        ]
      }
    ]
  }
}
